<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny Living World: one cell, drawn as a square centred in the cell like an icon; resized larger, it fills the widget. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp" android:minHeight="40dp" android:targetCellWidth="1" android:targetCellHeight="1"
    android:minResizeWidth="40dp" android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical" android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_tree" android:previewImage="@drawable/world_preview"
    android:widgetCategory="home_screen" android:description="@string/world_widget_description" />
