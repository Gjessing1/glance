<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/departure_item" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:orientation="vertical">
    <LinearLayout android:id="@+id/line_badge" android:layout_width="wrap_content" android:layout_height="28dp" android:minWidth="58dp" android:gravity="center" android:orientation="horizontal" android:paddingLeft="7dp" android:paddingRight="9dp" android:background="@drawable/badge_bus">
        <ImageView android:id="@+id/mode_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_bus" android:importantForAccessibility="no" />
        <TextView android:id="@+id/line_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/departure_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingStart="2dp" android:fontFamily="sans-serif-medium" android:textSize="16sp" android:textColor="@color/glance_ink" />
    <TextView android:id="@+id/departure_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="2dp" android:textSize="11sp" android:textColor="@color/glance_muted" android:visibility="gone" />
</LinearLayout>
