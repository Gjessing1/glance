<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/line_badge" android:layout_width="wrap_content" android:layout_height="26dp" android:minWidth="50dp" android:gravity="center" android:orientation="horizontal" android:paddingLeft="6dp" android:paddingRight="8dp" android:background="@drawable/badge_bus">
        <ImageView android:id="@+id/mode_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bus" android:importantForAccessibility="no" />
        <TextView android:id="@+id/line_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/leg_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:layout_marginStart="5dp" android:fontFamily="sans-serif-medium" android:textSize="15sp" android:textColor="@color/glance_ink" />
</LinearLayout>
