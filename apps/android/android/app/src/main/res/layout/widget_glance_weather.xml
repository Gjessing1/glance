<?xml version="1.0" encoding="utf-8"?>
<!-- The weather section: one piece of advice and its reason, with the current temperature at the end when asked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/weather_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:background="@drawable/group_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/weather_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:textSize="20sp" android:visibility="gone" />
        <ImageView android:id="@+id/weather_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="10dp" android:src="@drawable/ic_umbrella" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/weather_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/glance_ink" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/weather_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/glance_muted" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/weather_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:textSize="18sp" android:textColor="@color/glance_ink" android:maxLines="1" android:visibility="gone" />
        <ImageView android:id="@+id/weather_refresh" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="-6dp" android:paddingLeft="8dp" android:paddingRight="4dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:src="@drawable/ic_refresh" android:contentDescription="Refresh" android:visibility="gone" />
        <!-- While a tapped refresh runs: the seconds it should still take. -->
        <TextView android:id="@+id/weather_refresh_count" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="-6dp" android:paddingLeft="8dp" android:paddingRight="4dp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:textColor="@color/glance_ink" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/weather_hours" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone" />
</LinearLayout>
