<?xml version="1.0" encoding="utf-8"?>
<!-- One vehicle of the next connection, side by side with the next: badge and stop, departure and countdown, arrival.
     A tap opens its journey sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/leg_item" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/line_badge" android:layout_width="wrap_content" android:layout_height="22dp" android:minWidth="40dp" android:gravity="center" android:orientation="horizontal" android:paddingLeft="5dp" android:paddingRight="7dp" android:background="@drawable/badge_bus">
            <ImageView android:id="@+id/mode_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_bus" android:importantForAccessibility="no" />
            <TextView android:id="@+id/line_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/leg_from" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="12sp" android:textColor="@color/glance_ink" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:baselineAligned="true" android:orientation="horizontal">
        <TextView android:id="@+id/leg_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textSize="21sp" android:textColor="@color/glance_ink" android:maxLines="1" />
        <TextView android:id="@+id/leg_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:textColor="@color/glance_ink" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/leg_arrival" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/glance_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
