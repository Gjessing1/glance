<?xml version="1.0" encoding="utf-8"?>
<!-- One direction of the local buses: where to ("→ Asker") on its own line, with room on its right for how old the times
     are when they may no longer be live, then the next departures across the card's whole width as compact badges with
     their countdowns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/local_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:includeFontPadding="false" android:textStyle="bold" android:textSize="11sp" android:textColor="@color/glance_ink" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/local_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:includeFontPadding="false" android:textSize="11sp" android:textColor="@color/glance_late" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/local_departures" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
    <TextView android:id="@+id/local_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No buses in the next hours" android:textSize="12sp" android:textColor="@color/glance_muted" android:visibility="gone" />
</LinearLayout>
